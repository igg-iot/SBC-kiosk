[Unit]
Description=Kiosk MQTT Bridge
After=network-online.target kiosk.service
Wants=network-online.target kiosk.service

[Service]
Type=simple
User=kiosk
Group=kiosk
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/kiosk-mqtt-bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
