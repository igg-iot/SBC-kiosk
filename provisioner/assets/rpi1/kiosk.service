[Unit]
Description=Minimalist Web Kiosk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiosk
Group=kiosk
EnvironmentFile=/etc/default/kiosk
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1001/bus
Environment=WEBKIT_DISABLE_DMABUF_RENDERER=1
Environment=WPE_WEB_PROCESS_MAX_COUNT=1
Environment=JSGC_EXTRA_MEMORY_THRESHOLD=1
Environment=G_SLICE=always-malloc
Environment="WPE_USER_AGENT=Mozilla/5.0 (Linux; Android 13; SM-S918B) AppleWebKit/537.36 (KHTML, like Gecko) Version/16.6 Mobile Safari/537.36"
ExecStartPre=/bin/sh -c 'echo 0 | sudo /usr/bin/tee /sys/class/vtconsole/vtcon1/bind >/dev/null 2>&1 || true'
ExecStart=/usr/bin/cog -P drm -O renderer=gles,rotation=${KIOSK_ROTATION} --webprocess-failure=restart https://example.com
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
